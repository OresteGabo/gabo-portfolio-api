# Export these variables before bootRun; Spring does not automatically read .env.
SPRING_PROFILES_ACTIVE=local
GABO_DATABASE_URL=jdbc:postgresql://localhost:55432/gabo_portfolio
GABO_DATABASE_USER=gabo
GABO_DATABASE_PASSWORD=choose-a-local-password
GABO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
BONDS_ADMIN_EMAIL=you@example.com
# Reuse your existing hash, or generate with scripts/hash-password.sh.
BONDS_ADMIN_PASSWORD_HASH=
# Optional environment-managed friend account; existing web hash is supported.
BONDS_FRIEND_EMAIL=
BONDS_FRIEND_PASSWORD_HASH=
CRON_SECRET=
BONDS_MARKET_SNAPSHOT_SECRET=
# Optional one-time import; leave unset during normal operation.
# GABO_IMPORT_WEB_DIRECTORY=/absolute/path/to/gabo
